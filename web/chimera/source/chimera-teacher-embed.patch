+export const THEME = { light: false, bg: "#000000", add: "lighter" as GlobalCompositeOperation };
+
+/** Dark lines on `bg`, in the colours of the page around: `colors` replaces palette entries. */
+export function useLightTheme(bg: string, colors: Partial<typeof V>, heatStops: string[], text?: { primary: string; secondary: string }): void {
+  THEME.light = true;
