diff --git a/src/ui/teacher/Coach.tsx b/src/ui/teacher/Coach.tsx
new file mode 100644
index 0000000..501ba1e
--- /dev/null
+++ b/src/ui/teacher/Coach.tsx
@@ -0,0 +1,226 @@
+/**
+ * The coach embed, "John": the 3D head. He sings one note when the page around asks, on its
+ * solfège name (do re mi fa sol la, from exact IPA), so you see the tongue, jaw and lips before
+ * your turn; while he sings, his pitch goes to the page ("pitch" messages) to draw on its lane. Another page shows it in an iframe and talks to it with postMessage (same origin only):
+ *
+ *   in   { type: "sing", midi, word?, seconds = 1.6, name?, backing? }  sing one note; name "mi" sings mi, else word, else "la"
+ *        { type: "stop" }                                              stop singing
+ *        { type: "idle", text? }                                       clear the note, say something else
+ *        { type: "body", body: "male" | "female" | "child" }
+ *        { type: "mute", on }                                          the head still sings, silently
+ *   out  { source: "chimera-coach", type: "ready" | "started" | "singing" | "sang" | "needs-click", midi? }
+ *        { source: "chimera-coach", type: "pitch", f0 }                 his pitch (Hz), 20 times a second while he sings
+ *
+ * Browsers start audio only from a click inside this frame, so until then a Start button waits
+ * over the head, and a note asked for meanwhile is sung as soon as it is clicked.
+ * URL: ?body=male|female|child, ?muted=1.
+ */
+import { StrictMode, useEffect, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { AnatomyView3D } from "../components/AnatomyView3D.tsx";
+import { useStore } from "../store.ts";
+import { engine } from "../../audio/AudioEngine.ts";
+import { useSing, sungNow } from "../singing.ts";
+import { mouthWords } from "../mouthWords.ts";
+import { PRESETS } from "../body.ts";
+import { V } from "../colors.ts";
+import type { BodyName } from "../../worklet/protocol.ts";
+import type { ViewFlags } from "../render/anatomy.ts";
+import type { Syllable } from "../../wasm/types.ts";
+
+const LETTERS = ["C", "C♯", "D", "E♭", "E", "F", "F♯", "G", "A♭", "A", "B♭", "B"];
+const noteName = (midi: number) => `${LETTERS[((midi % 12) + 12) % 12]}${Math.floor(midi / 12) - 1}`;
+
+/** The six names as sung (English letter-to-sound reads "mi" as "mih" and "fa" as in "fat"). */
+const syl = (text: string, onset: string[], vowel: string, coda: string[] = []): Syllable => ({
+  text,
+  onset: onset.map((ipa) => ({ ipa, stress: 0 })),
+  nucleus: { ipa: vowel, stress: 1 },
+  coda: coda.map((ipa) => ({ ipa, stress: 0 })),
+  wordEnd: true,
+  phraseEnd: false,
+});
+const SOLFEGE: Record<string, Syllable> = {
+  do: syl("do", ["d"], "oʊ"),
+  re: syl("re", ["ɹ"], "eɪ"),
+  mi: syl("mi", ["m"], "i"),
+  fa: syl("fa", ["f"], "ɑ"),
+  sol: syl("sol", ["s"], "oʊ", ["l"]),
+  la: syl("la", ["l"], "ɑ"),
+};
+
+/** One line of coaching per name: what the mouth does, dry as a simulated throat. */
+const QUIPS: Record<string, string> = {
+  do: "Round lips, like a little O. Low and lazy.",
+  re: "Ray. A tiny smile on the ay. Tongue stays relaxed.",
+  mi: "Mee. Big smile, tongue high. Like you just saw cheese.",
+  fa: "Fah. Jaw drops. The doctor says aah.",
+  sol: "Sole. Round lips again, then the tongue taps up for the L.",
+  la: "Lah. Tongue flicks up for the L, then the jaw falls.",
+};
+const ANY_QUIP = "Copy my throat. It's open source.";
+const AFTER = ["Same shape, your own throat.", "I'll be watching. I have no eyelids.", "Copy me. I'm told it's flattering."];
+const cap = (w: string) => w.charAt(0).toUpperCase() + w.slice(1);
+
+const VIEW: ViewFlags = { pressure: true, particles: true, grid: false, calipers: false };
+const words = mouthWords(sungNow, V.green);
+
+interface Ask {
+  midi: number;
+  word: string;
+  seconds: number;
+  name?: string;
+  /** a backing note (band mode): no "your turn" after it */
+  backing?: boolean;
+}
+
+type Caption = { line: string; quip: string; mood: "wait" | "sing" | "after" };
+
+const tell = (type: string, extra: Record<string, unknown> = {}) => {
+  if (window.parent !== window) window.parent.postMessage({ source: "chimera-coach", type, ...extra }, location.origin);
+};
+
+const BODIES: BodyName[] = ["male", "female", "child"];
+
+function Coach() {
+  const started = useStore((s) => s.started);
+  const starting = useStore((s) => s.starting);
+  const [caption, setCaption] = useState<Caption>({ line: "Hi, I'm John.", quip: "All throat, no body. I sing it first, you copy it.", mood: "wait" });
+  const [pending, setPending] = useState<Ask | null>(null);
+  const [muted, setMuted] = useState(new URLSearchParams(location.search).get("muted") === "1");
+
+  useEffect(() => {
+    useStore.getState().setVolume(muted ? 0 : 0.8);
+  }, [muted]);
+
+  useEffect(() => {
+    const q = new URLSearchParams(location.search).get("body");
+    if (q && (BODIES as string[]).includes(q)) useStore.getState().setBody(PRESETS[q as BodyName]);
+    useStore.getState().setView({ ...VIEW, threeD: true });
+    let timer = 0;
+    let afterTimer = 0;
+    let turn = 0;
+    let singing = false;
+    // his pitch for the page's lane, from the engine's telemetry
+    const pitch = window.setInterval(() => {
+      const t = engine.latest?.t;
+      if (singing && t && t.voicing > 0.3 && t.f0 > 0) tell("pitch", { f0: t.f0 });
+    }, 50);
+
+    const release = () => {
+      singing = false;
+      clearTimeout(timer);
+      const st = useStore.getState();
+      for (const n of st.heldNotes) st.noteOff(n);
+    };
+
+    const sing = (ask: Ask) => {
+      const st = useStore.getState();
+      const shown = SOLFEGE[ask.name ?? ""] ? ask.name! : ask.word;
+      const quip = ask.backing ? "Backing vocals. Living the dream." : (QUIPS[shown] ?? ANY_QUIP);
+      if (!st.started) {
+        setPending(ask);
+        setCaption({ line: `I want to sing ${ask.name ?? noteName(ask.midi)}!`, quip: "Click Start, browsers won't let me make a sound until you do.", mood: "wait" });
+        tell("needs-click", { midi: ask.midi });
+        return;
+      }
+      release();
+      clearTimeout(afterTimer);
+      const exact = SOLFEGE[shown];
+      if (exact) useSing.setState({ lyrics: shown, syllables: [exact], cursor: 0 });
+      else useSing.getState().setLyrics(shown);
+      st.noteOn(ask.midi, 96);
+      singing = true;
+      setCaption({ line: `${cap(shown)}! (${noteName(ask.midi)})`, quip, mood: "sing" });
+      tell("singing", { midi: ask.midi });
+      const my = ++turn;
+      timer = window.setTimeout(() => {
+        useStore.getState().noteOff(ask.midi);
+        singing = false;
+        tell("sang", { midi: ask.midi });
+        if (ask.backing) return;
+        afterTimer = window.setTimeout(() => {
+          if (my === turn) setCaption({ line: `Your turn now: ${shown}`, quip: AFTER[my % AFTER.length], mood: "after" });
+        }, 400);
+      }, Math.max(0.3, ask.seconds) * 1000);
+    };
+    (window as unknown as { __coachSing: (a: Ask) => void }).__coachSing = sing;
+
+    const onMessage = (e: MessageEvent) => {
+      if (e.origin !== location.origin || !e.data || typeof e.data !== "object") return;
+      const m = e.data as Record<string, unknown>;
+      if (m.type === "sing" && typeof m.midi === "number" && m.midi >= 24 && m.midi <= 96) {
+        sing({ midi: Math.round(m.midi), word: typeof m.word === "string" && m.word ? m.word.toLowerCase() : "la", seconds: typeof m.seconds === "number" ? m.seconds : 1.6, name: typeof m.name === "string" ? m.name : undefined, backing: m.backing === true });
+      } else if (m.type === "stop") {
+        turn++;
+        release();
+        setPending(null);
+      } else if (m.type === "idle") {
+        turn++;
+        release();
+        setPending(null);
+        setCaption({ line: "John", quip: typeof m.text === "string" ? m.text : "Resting my vocal folds. They're made of maths.", mood: "wait" });
+      } else if (m.type === "body" && typeof m.body === "string" && (BODIES as string[]).includes(m.body)) {
+        useStore.getState().setBody(PRESETS[m.body as BodyName]);
+      } else if (m.type === "mute") {
+        setMuted(!!m.on);
+      }
+    };
+    window.addEventListener("message", onMessage);
+    tell("ready");
+    return () => {
+      window.removeEventListener("message", onMessage);
+      clearInterval(pitch);
+      release();
+    };
+  }, []);
+
+  const start = async () => {
+    await useStore.getState().start();
+    if (!useStore.getState().started) return;
+    tell("started");
+    const ask = pending;
+    setPending(null);
+    if (ask) (window as unknown as { __coachSing: (a: Ask) => void }).__coachSing(ask);
+    else setCaption({ line: "Ready.", quip: "Warmed up. Waiting for the arm to play a note.", mood: "wait" });
+  };
+
+  return (
+    <div className="coach">
+      <div className="coach-head">
+        <AnatomyView3D readouts={false} showFormants={false} overlay={words} view={VIEW} />
+      </div>
+      <div className="coach-caption" data-mood={caption.mood}>
+        <p className="coach-line">{caption.line}</p>
+        <p className="coach-quip">{caption.quip}</p>
+      </div>
+      {!started && (
+        <button className="coach-start" type="button" onClick={() => void start()} disabled={starting}>
+          {starting ? "Clearing my throat…" : "Start John"}
+          <small>sound needs one click</small>
+        </button>
+      )}
+      <button className="coach-mute" type="button" aria-pressed={muted} onClick={() => setMuted(!muted)} title="The head still sings, silently, so the microphone hears only you">
+        {muted ? "Muted" : "Sound on"}
+      </button>
+      <p className="coach-credit">
+        voice by{" "}
+        <a href="https://github.com/jamesondh/chimera-vocal-synth" target="_blank" rel="noreferrer">
+          Chimera
+        </a>{" "}
+        (MIT)
+      </p>
+    </div>
+  );
+}
+
+export function mountCoach(root: HTMLElement): void {
+  // console/debug handle, as in mount.tsx
+  (window as unknown as { __chimeraEngine: typeof engine }).__chimeraEngine = engine;
+  root.replaceChildren();
+  createRoot(root).render(
+    <StrictMode>
+      <Coach />
+    </StrictMode>,
+  );
+}
diff --git a/src/ui/teacher/teacher.css b/src/ui/teacher/teacher.css
new file mode 100644
