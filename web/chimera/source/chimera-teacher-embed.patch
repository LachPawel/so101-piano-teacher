diff --git a/vite.teacher.config.ts b/vite.teacher.config.ts
new file mode 100644
index 0000000..0110dcc
--- /dev/null
+++ b/vite.teacher.config.ts
@@ -0,0 +1,20 @@
+// The coach embed (teacher.html) on its own: relative paths, so it can be copied into any folder
+// of another site and opened there (the piano teacher vendors it under web/chimera/).
+// Build: cargo build -p chimera-wasm --release --target wasm32-unknown-unknown, copy the wasm as
+// the `wasm` script does, then `vite build --config vite.teacher.config.ts`.
+import { defineConfig } from "vite";
+import react from "@vitejs/plugin-react";
+
+export default defineConfig({
+  base: "./",
+  plugins: [react()],
+  worker: { format: "es" },
+  build: {
+    target: "es2022",
+    outDir: "dist-teacher",
+    emptyOutDir: true,
+    chunkSizeWarningLimit: 1200,
+    rolldownOptions: { input: "teacher.html" },
+  },
+  server: { host: "127.0.0.1", port: 5319, strictPort: true },
+});
