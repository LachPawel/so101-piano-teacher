+/**
+ * Entry of the coach embed (teacher.html): the engine first, as in main.tsx, then the coach.
+ */
+import "./ui/styles.css";
+import "./ui/teacher/teacher.css";
+import { initChimera } from "./wasm/chimera.ts";
+import { useLightTheme } from "./ui/colors.ts";
+
+// the piano teacher's colours (so101-piano-teacher web/css/style.css): olive lines on paper, warm sound
+useLightTheme(
+  "#ffffff", // white: under the page's multiply blend the background vanishes
+  { blue: "#8e917c", blueMid: "#b0b29f", blueDim: "#dcd9ca", frame: "#e3dfd1", green: "#4f6a2c", red: "#a94b36", pink: "#d87827", white: "#282b23", amber: "#d87827" },
+  ["#f6efdc", "#ecc98a", "#d87827", "#a94b36", "#5d2a17"],
+  { primary: "#282b23", secondary: "#797b6e" },
+);
+
+const root = document.getElementById("root")!;
+
+async function boot(): Promise<void> {
+  try {
+    await initChimera();
+  } catch (err) {
+    root.textContent = `The voice engine could not load: ${err instanceof Error ? err.message : String(err)}`;
+    root.className = "coach-error";
+    return;
+  }
+  const { mountCoach } = await import("./ui/teacher/Coach.tsx");
+  mountCoach(root);
+}
+
+void boot();
