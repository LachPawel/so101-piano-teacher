@@ -0,0 +1,147 @@
+/* The coach embed: the head fills the frame, words float over it. Colours and type are the piano
+   teacher's (so101-piano-teacher web/css/style.css), so the frame sits on its page as one piece. */
+html {
+  background: #fffcf5;
+}
+
+body.teacher {
+  --paper: #fffcf5;
+  --ink: #282b23;
+  --olive: #4b5039;
+  --muted: #797b6e;
+  --line: #e3dfd1;
+  --accent: #637747;
+  --warm: #d87827;
+  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --mono: ui-monospace, SFMono-Regular, monospace;
+  overflow: hidden;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  color-scheme: light;
+}
+
+body.teacher #root,
+.coach {
+  position: fixed;
+  inset: 0;
+}
+
+.coach-error {
+  padding: 24px;
+  color: #a94b36;
+}
+
+.coach-caption {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  padding: 12px 18px 0;
+  pointer-events: none;
+}
+
+.coach-line {
+  margin: 0;
+  font: 700 clamp(20px, 6vmin, 42px) / 1.05 var(--sans);
+  letter-spacing: -0.04em;
+  color: var(--olive);
+}
+
+.coach-caption[data-mood="sing"] .coach-line {
+  color: var(--accent);
+}
+
+.coach-caption[data-mood="after"] .coach-line {
+  color: var(--warm);
+}
+
+.coach-quip {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 30px;
+  margin: 0;
+  padding: 18px 18px 4px;
+  pointer-events: none;
+  background: linear-gradient(rgba(255, 252, 245, 0), var(--paper) 45%);
+  font-size: clamp(11px, 2.6vmin, 16px);
+  line-height: 1.35;
+  color: var(--muted);
+}
+
+.coach-start {
+  position: absolute;
+  left: 50%;
+  bottom: 24%;
+  transform: translateX(-50%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 2px;
+  padding: 11px 20px;
+  border: 0;
+  border-radius: 9px;
+  background: var(--accent);
+  color: var(--paper);
+  font: 650 clamp(14px, 3.4vmin, 20px) var(--sans);
+  cursor: pointer;
+  box-shadow: 0 8px 24px rgba(64, 70, 45, 0.18);
+  animation: coach-pulse 1.6s ease-in-out infinite;
+}
+
+.coach-start small {
+  font: 500 0.55em var(--mono);
+  letter-spacing: 0.08em;
+  opacity: 0.8;
+}
+
+.coach-start:disabled {
+  animation: none;
+  cursor: progress;
+}
+
+@keyframes coach-pulse {
+  50% {
+    box-shadow: 0 0 0 6px rgba(99, 119, 71, 0.2);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .coach-start {
+    animation: none;
+  }
+}
+
+.coach-mute {
+  position: absolute;
+  right: 10px;
+  bottom: 8px;
+  padding: 3px 9px;
+  border: 1px solid #d8d4c6;
+  border-radius: 7px;
+  background: var(--paper);
+  color: var(--muted);
+  font: 500 10px var(--mono);
+  letter-spacing: 0.06em;
+  cursor: pointer;
+}
+
+.coach-mute[aria-pressed="true"] {
+  color: var(--warm);
+  border-color: var(--warm);
+}
+
+.coach-credit {
+  position: absolute;
+  left: 12px;
+  bottom: 10px;
+  margin: 0;
+  font: 9px var(--mono);
+  letter-spacing: 0.08em;
+  color: var(--muted);
+}
+
+.coach-credit a {
+  color: var(--accent);
+}
